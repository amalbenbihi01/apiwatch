// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                        String              @id @default(uuid())
  name                      String
  email                     String              @unique
  passwordHash              String
  emailNotificationsEnabled Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  apiEndpoints              ApiEndpoint[]
  incidents                 Incident[]
  notificationLogs          NotificationLog[]
  inAppNotifications        InAppNotification[]
  statusPage                StatusPage?
  teamMemberships           TeamMember[]
  sentInvitations           TeamInvitation[]
  dashboardPreferences      DashboardPreference[]

  @@map("users")
}

model Team {
  id                   String                @id @default(uuid())
  name                 String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  members              TeamMember[]
  invitations          TeamInvitation[]
  endpoints            ApiEndpoint[]
  dashboardPreferences DashboardPreference[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  role      TeamRole @default(MEMBER)
  teamId    String
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("team_members")
}

model TeamInvitation {
  id          String   @id @default(uuid())
  email       String
  role        TeamRole @default(MEMBER)
  tokenHash   String   @unique
  expiresAt   DateTime
  teamId      String
  invitedById String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([teamId])
  @@map("team_invitations")
}

model ApiEndpoint {
  id          String  @id @default(uuid())
  name        String
  url         String
  method      String  @default("GET")
  description String?
  isActive    Boolean @default(true)
  isPublic    Boolean @default(false)

  // Request Configuration
  headersJson     Json?
  queryParamsJson Json?
  bodyJson        String?

  // Monitoring / Alert Configuration
  timeoutMs               Int  @default(5000)
  responseTimeThresholdMs Int?
  unhealthyThreshold      Int  @default(1)
  recoveryThreshold       Int  @default(1)

  // Alert recipients
  alertEmails Json?

  // Webhook configuration
  webhookUrl    String?
  webhookSecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Team association (mandatory, protected from deletion if endpoints exist)
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  // Author / creator traceability
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks             ApiCheck[]
  incidents          Incident[]
  inAppNotifications InAppNotification[]

  @@index([teamId])
  @@map("api_endpoints")
}

model ApiCheck {
  id             String   @id @default(uuid())
  status         String // "UP" ou "DOWN"
  httpStatusCode Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime @default(now())

  endpointId String
  endpoint   ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, checkedAt])
  @@index([checkedAt])
  @@map("api_checks")
}

model Incident {
  id         String    @id @default(uuid())
  status     String    @default("OPEN") // "OPEN" ou "RESOLVED"
  title      String?
  cause      String?
  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  endpointId String
  endpoint   ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationLogs   NotificationLog[]
  inAppNotifications InAppNotification[]

  @@index([endpointId, status])
  @@index([userId, status])
  @@map("incidents")
}

model NotificationLog {
  id        String    @id @default(uuid())
  type      String // "INCIDENT_OPEN" ou "INCIDENT_RESOLVED"
  channel   String    @default("EMAIL")
  status    String // "SENT" ou "FAILED"
  recipient String
  subject   String?
  message   String?
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, type])
  @@index([userId, createdAt])
  @@map("notification_logs")
}

model InAppNotification {
  id        String    @id @default(uuid())
  type      String // "INCIDENT_OPEN" ou "INCIDENT_RESOLVED"
  title     String
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  endpointId String
  endpoint   ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, type])
  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("in_app_notifications")
}

model StatusPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String   @default("System Status")
  description String?
  isEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("status_pages")
}

model DashboardPreference {
  id        String   @id @default(uuid())
  userId    String
  teamId    String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@map("dashboard_preferences")
}
