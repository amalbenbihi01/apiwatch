// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                @id @default(uuid())
  name                      String
  email                     String                @unique
  passwordHash              String
  emailNotificationsEnabled Boolean               @default(true)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  apiEndpoints              ApiEndpoint[]
  incidents                 Incident[]
  notificationLogs          NotificationLog[]
  inAppNotifications        InAppNotification[]

  @@map("users")
}

model ApiEndpoint {
  id                 String              @id @default(uuid())
  name               String
  url                String
  method             String              @default("GET")
  description        String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks             ApiCheck[]
  incidents          Incident[]
  inAppNotifications InAppNotification[]

  @@map("api_endpoints")
}

model ApiCheck {
  id             String      @id @default(uuid())
  status         String // "UP" ou "DOWN"
  httpStatusCode Int?
  responseTimeMs Int?
  errorMessage   String?
  checkedAt      DateTime    @default(now())

  endpointId     String
  endpoint       ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, checkedAt])
  @@map("api_checks")
}

model Incident {
  id                 String              @id @default(uuid())
  status             String              @default("OPEN") // "OPEN" ou "RESOLVED"
  title              String?
  cause              String?
  startedAt          DateTime            @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  endpointId         String
  endpoint           ApiEndpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationLogs   NotificationLog[]
  inAppNotifications InAppNotification[]

  @@index([endpointId, status])
  @@index([userId, status])
  @@map("incidents")
}

model NotificationLog {
  id         String    @id @default(uuid())
  type       String    // "INCIDENT_OPEN" ou "INCIDENT_RESOLVED"
  channel    String    @default("EMAIL")
  status     String    // "SENT" ou "FAILED"
  recipient  String
  subject    String?
  message    String?
  error      String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  incidentId String
  incident   Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, type])
  @@index([userId, createdAt])
  @@map("notification_logs")
}

model InAppNotification {
  id          String      @id @default(uuid())
  type        String      // "INCIDENT_OPEN" ou "INCIDENT_RESOLVED"
  title       String
  message     String
  isRead      Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())

  endpointId  String
  endpoint    ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  incidentId  String
  incident    Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, type])
  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("in_app_notifications")
}
