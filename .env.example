# ==============================================================================
# APIWatch — Configuration d'Environnement (.env)
# ==============================================================================
# Copiez ce fichier vers .env et remplacez les valeurs par vos configurations de production.
# NE COMMITEZ JAMAIS LE FICHIER .env CONTENANT DE VRAIS SECRETS DANS GIT.

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER="apiwatch_user"
POSTGRES_PASSWORD="changez-ce-mot-de-passe-en-production"
POSTGRES_DB="apiwatch_db"

# En local hors Docker :
DATABASE_URL="postgresql://apiwatch_user:changez-ce-mot-de-passe-en-production@localhost:5432/apiwatch_db?schema=public"
# Dans Docker Compose (géré automatiquement via docker-compose.yml) :
# DATABASE_URL="postgresql://apiwatch_user:changez-ce-mot-de-passe-en-production@postgres:5432/apiwatch_db?schema=public"

# ------------------------------------------------------------------------------
# 2. Sécurité & Authentification (JWT HTTP-only)
# ------------------------------------------------------------------------------
# Secret pour la signature JWT (générer une clé aléatoire d'au moins 32 caractères)
JWT_SECRET="changez-ce-secret-en-production-jwt-32bytes-min"

# ------------------------------------------------------------------------------
# 3. Monitoring & Scheduler
# ------------------------------------------------------------------------------
# Intervalle en minutes entre deux vérifications du scheduler interne
MONITORING_INTERVAL_MINUTES=5

# Secret pour protéger le déclencheur externe POST /api/cron/monitoring
CRON_SECRET="changez-ce-secret-en-production-cron"

# ------------------------------------------------------------------------------
# 4. URL de l'Application
# ------------------------------------------------------------------------------
# URL publique utilisée pour les liens dans les emails (invitations, alertes).
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. Configuration Emailing SMTP (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="votre_utilisateur_smtp"
SMTP_PASS="votre_mot_de_passe_smtp"
EMAIL_FROM="APIWatch Alerting <no-reply@apiwatch.io>"
